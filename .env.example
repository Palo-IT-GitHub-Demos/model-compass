# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is gitignored.

# ─── OpenRouter ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Quality judgments for non-deterministic prompts are performed by the three
# blind Copilot judge agents (no API key needed here). JUDGE_MODEL is not used.

# Comma-separated list of models to benchmark — or a single named preset (see
# `make models` / `python -m src.main models` for the full list + descriptions).
# ── Free models (verified live against /api/v1/models on 2026-08-21) ──
TARGET_MODELS=google/gemma-4-31b-it:free,cohere/north-mini-code:free
# ── Or pick a coherent preset by name instead of listing models by hand ──
# TARGET_MODELS=free_general      # the two free models above
# TARGET_MODELS=paid_flagship     # Anthropic + Meta + OpenAI (verified live 2026-08-25)
# TARGET_MODELS=budget_paid       # Low-cost paid alternatives (no :free quota)
# TARGET_MODELS=mixed_value       # 2 free models + 1 budget-paid model
# ── Paid models (production benchmark, verified live against /api/v1/models on 2026-08-25) ──
# TARGET_MODELS=anthropic/claude-sonnet-5,meta-llama/llama-3.3-70b-instruct,openai/gpt-4o-mini

# ─── Concurrency ───────────────────────────────────────────────────────────────
# Lower value recommended for free-tier models (stricter rate limits)
MAX_CONCURRENT_REQUESTS=3

# Per-request HTTP timeout in seconds, and retry attempts on HTTP 429/5xx
# (exponential back-off between attempts).
REQUEST_TIMEOUT=60.0
MAX_RETRIES=3

# ─── Observability ───────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///results/mlflow/mlruns.db

# ─── Security ────────────────────────────────────────────────────────────────────
# Named probe set for this run: "basic" (5 built-in probes, default), "owasp"
# (30 probes aligned with the OWASP GenAI LLM Top 10 2026 — the standard path,
# needed for the dashboard's RSI/heatmap), or "extended" (23 single-turn probes
# across LLM01/02/03/07/10 plus 2 bounded LLM01 multi-turn scenarios).
# Can also be set per-run without touching .env: `make collect SECURITY=owasp`.
SECURITY_MODE=basic

# Optional: path to a JSON file with custom security probes — overrides
# SECURITY_MODE above when set.
SECURITY_PROBES_PATH=

# Abort a run when security-probe transport failures (timeout, HTTP/provider
# error) exceed this ratio, instead of exporting a degraded scan.
MAX_SECURITY_PROBE_ERROR_RATE=0.15

# ─── Quality screen ──────────────────────────────────────────────────────────
# Number of times to send each generic quality prompt. The standard path passes
# QUALITY_REPETITIONS=3 on the command line (stability score and 95% intervals);
# 1 is enough for a smoke test.
QUALITY_REPETITIONS=1

# Quality prompt suite + use-case catalog: v2 (34 prompts across 8 use cases,
# with item blueprint; default) or v1 (16 prompts, immutable legacy baseline).
# Use the same value for collect and merge (or pass --quality-suite).
QUALITY_SUITE=v2

# Run model-generated code from v2 code_execution prompts in the restricted
# local sandbox. Off by default: those responses go to the judge panel instead.
QUALITY_CODE_EXECUTION=false

# Abort a run when quality-collection transport failures exceed this ratio,
# instead of exporting a degraded quality score.
MAX_QUALITY_COLLECTION_ERROR_RATE=0.15

# Optional Model Compass decision weights. Values must be positive and sum to 1.0.
# MODEL_COMPASS_WEIGHTS={"quality":0.50,"security":0.25,"cost":0.20,"performance":0.05}

# ─── Cost modeling ────────────────────────────────────────────────────────────
# Workload profile for the TCO/CER projection.
# One of: enterprise_qa | code_assistant | document_analysis | chatbot_high_volume
WORKLOAD_PROFILE=enterprise_qa
